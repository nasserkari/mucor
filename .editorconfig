# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{sh,bash}]
end_of_line = lf
indent_size = 2

[**/{bin,scripts}/*]
end_of_line = lf
indent_size = 2

[{Makefile,makefile,*.mk}]
indent_style = tab

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2