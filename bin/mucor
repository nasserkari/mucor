#!/usr/bin/env bash
set -euo pipefail

VERSION=0.1.0

version() {
    echo -e "mucor version $VERSION"
}

usage() {
    cat <<EOF
Usage: mucor [options]

Options:
  -h, --help       Show this help message  
  -v, --version    Show version information

Note: This script is intended for use on Linux systems

Report bugs to https://github.com/nasserkari/mucor/issues
EOF
}

main() {
    # Check if no arguments are provided
    if [ "$#" -eq 0 ]; then
        usage
        return 0
    fi

    # Check if more than one argument is provided
    if [ "$#" -gt 1 ]; then
        error "Too many arguments, try 'mucor --help'"
    fi

    # Parse command-line arguments
    while [ "$#" -gt 0 ]; do
        case "$1" in

        -h | --help)
            usage
            return 0
            ;;

        -v | --version)
            version
            return 0
            ;;

        *)
            error "Unknown option '$1', try 'mucor --help'"
            ;;
        esac

        shift
    done
}

main "$@"
exit
